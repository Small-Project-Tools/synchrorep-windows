<?xml version="1.0" encoding="utf-8"?>
<!-- Single full-featured Synchrorep installer. Generated runtime components
     are injected from the checksum-verified Windows curl dependency set. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Synchrorep" Manufacturer="Synchrorep contributors"
           Version="0.13.8" Language="1033"
           UpgradeCode="E7933186-3749-4B61-AD35-68A48EB337CD">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"/>
    <MajorUpgrade DowngradeErrorMessage="A newer Synchrorep version is already installed."/>
    <MediaTemplate EmbedCab="yes"/>
    <Icon Id="SynchrorepIcon" SourceFile="$(var.SourceIcon)"/>
    <Property Id="ARPPRODUCTICON" Value="SynchrorepIcon"/>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Synchrorep">
          <Component Id="AppComponent" Guid="247755EB-32CB-5BC9-977A-C42D4D1E79C6" Win64="yes">
            <File Id="AppFile" Source="$(var.SourceExe)" Name="synchrorep.exe" KeyPath="yes">
              <Shortcut Id="StartMenuSynchrorep" Directory="ProgramMenuFolder"
                        Name="Synchrorep" WorkingDirectory="INSTALLFOLDER"
                        Advertise="yes" Icon="SynchrorepIcon" IconIndex="0"/>
            </File>
            <!-- All-user classic Explorer menus for folders, empty folder
                 background and drives. MSI removes these on uninstall. -->
            <RegistryValue Root="HKLM" Key="Software\Classes\Directory\shell\Synchrorep"
                           Type="string" Value="Synchronize with Synchrorep"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Directory\shell\Synchrorep"
                           Name="Icon" Type="string" Value="&quot;[#AppFile]&quot;,0"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Directory\shell\Synchrorep\command"
                           Type="string" Value="&quot;[#AppFile]&quot; &quot;%1&quot;"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Directory\Background\shell\Synchrorep"
                           Type="string" Value="Synchronize with Synchrorep"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Directory\Background\shell\Synchrorep"
                           Name="Icon" Type="string" Value="&quot;[#AppFile]&quot;,0"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Directory\Background\shell\Synchrorep\command"
                           Type="string" Value="&quot;[#AppFile]&quot; &quot;%V&quot;"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Drive\shell\Synchrorep"
                           Type="string" Value="Synchronize with Synchrorep"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Drive\shell\Synchrorep"
                           Name="Icon" Type="string" Value="&quot;[#AppFile]&quot;,0"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Drive\shell\Synchrorep\command"
                           Type="string" Value="&quot;[#AppFile]&quot; &quot;%1&quot;"/>
          </Component>
          <Component Id="ExtensionComponent" Guid="4D909B2C-B0A0-5292-BD39-389539EC7739" Win64="yes">
            <File Id="ExtensionFile" Source="$(var.SourceExplorerDll)" Name="SynchrorepExplorer.dll" KeyPath="yes"/>
          </Component>
          <Component Id="LicenseComponent" Guid="883B7273-BB3E-55BC-B2A8-49D13CDA07B4" Win64="yes">
            <File Id="LicenseFile" Source="$(var.SourceLicense)" Name="LICENSE" KeyPath="yes"/>
          </Component>
          <Component Id="ThirdPartyNotices" Guid="*">
            <File Id="ThirdPartyNoticesFile" Source="$(var.SourceNotices)"
                  Name="THIRD_PARTY_NOTICES.txt" KeyPath="yes"/>
          </Component>
          <!-- RUNTIME_COMPONENTS -->
        </Directory>
      </Directory>
    </Directory>
    <Feature Id="MainFeature" Title="Synchrorep" Level="1">
      <ComponentRef Id="AppComponent"/>
      <ComponentRef Id="ExtensionComponent"/>
      <ComponentRef Id="LicenseComponent"/>
      <ComponentRef Id="ThirdPartyNotices"/>
      <!-- RUNTIME_REFS -->
    </Feature>
  </Product>
</Wix>
